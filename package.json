  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local-upstream localhost:8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply starscout --local",
    "db:migrate:remote": "wrangler d1 migrations apply starscout --remote",
