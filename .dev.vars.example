# Local development settings. Copy this file to .dev.vars and fill in the values.
# .dev.vars is git-ignored; never commit it.

# From a GitHub OAuth app whose callback URL is http://localhost:8787/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 32 random bytes, base64. Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
